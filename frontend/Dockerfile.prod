# Frontend Dockerfile — production build for Railway deployment
# Build-time: bakes VITE_API_URL into the SPA bundle.
# Runtime: envsubst replaces ${BACKEND_URL} in nginx.conf with the Railway backend URL.
FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_API_URL=http://localhost:8080/money_tracker/api/v1
ENV VITE_API_URL=$VITE_API_URL

# Copy package files first (for layer caching)
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build the production bundle (VITE_API_URL is baked in at build time)
RUN npm run build

# Runtime stage — serve with nginx
FROM nginx:alpine

# envsubst is needed to inject BACKEND_URL into nginx.conf at startup
RUN apk add --no-cache gettext

# Copy the built assets from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx config (contains ${BACKEND_URL} placeholder)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Entrypoint: envsubst BACKEND_URL into nginx.conf, then start nginx
CMD ["sh", "-c", "envsubst '$BACKEND_URL' < /etc/nginx/conf.d/default.conf > /etc/nginx/conf.d/default.conf.tmp && mv /etc/nginx/conf.d/default.conf.tmp /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]

# Expose port 80
EXPOSE 80
