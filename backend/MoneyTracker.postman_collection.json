								{
									"key": "bank_statements",
									"type": "file",
									"src": "statement.csv"
								},
								{
									"key": "userId",
									"value": "{{userId}}",
									"type": "text"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});"
								]
							}
						}
					]
				},
